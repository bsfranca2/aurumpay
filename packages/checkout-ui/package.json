{
  "name": "@aurumpay/checkout-ui",
  "type": "module",
  "version": "0.0.0",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "style": "./dist/runtime/index.css",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ]
    }
  },
  "imports": {
    "#build/ui/*": "./.nuxt/ui/*.ts",
    "#build/ui.css": "./.nuxt/ui.css"
  },
  "style": "./dist/runtime/index.css",
  "files": [
    ".nuxt/ui",
    ".nuxt/ui.css",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "pnpm build",
    "dev": "nuxi dev",
    "prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@aurumpay/api-types": "workspace:*",
    "@aurumpay/lib": "workspace:*",
    "@nuxt/kit": "^3.18.1",
    "@nuxt/schema": "^3.18.1",
    "@nuxt/scripts": "^0.11.10",
    "@nuxtjs/i18n": "^9.5.6",
    "@tailwindcss/vite": "^4.1.12",
    "@vee-validate/valibot": "^4.15.1",
    "@vueuse/core": "^13.7.0",
    "defu": "^6.1.4",
    "lucide-vue-next": "^0.540.0",
    "reka-ui": "^2.4.1",
    "result": "workspace:*",
    "tailwindcss": "^4.1.12",
    "valibot": "^1.1.0",
    "vee-validate": "^4.15.1"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "nuxt": "^3.18.1",
    "vue-tsc": "^2.2.12"
  }
}
